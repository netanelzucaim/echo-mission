Build adjustments to nginx's packaging (pkg-oss @ aaeb9a9). Not a CVE fix, so it is
not in patches/. Applied by prepare.sh after the CVE patches. Three changes:

1. debian/Makefile: do not generate the Debian changelogs with xslscript, which
   pkg-oss downloads during the build; prepare.sh writes static ones instead.
2. debian/Makefile.module-njs: build the njs module and CLI without QuickJS, as in the
   original image (its njs 0.8.4 links no QuickJS). This also drops the checksum check
   of the njs tarball, which prepare.sh packs from the njs git tag.
3. debian/Makefile.module-njs: package release 3, so the njs package version is
   1.25.5+0.8.4-3~bookworm, the same as in the original image.

--- a/debian/Makefile
+++ b/debian/Makefile
@@ -150,8 +150,7 @@
 	ln -s $(CONTRIB)/tarballs/$(BASE_SRC) $(BASE_SRC)
 
 nginx.deb-changelog:
-	@echo "===> Generating $@"
-	@cd $(DOCS) && DEST=$(CURDIR) VERSIONMASK=1 make $(CURDIR)/nginx$(BASE_SUFFIX).deb-changelog
+	@echo "===> Using static $@ (xslscript docs generation skipped)"
 
 rules-base: $(BASE_SRC) nginx.deb-changelog
 	@echo "===> Creating $@"
@@ -243,9 +242,7 @@
 	esac
 
 nginx-module-%.deb-changelog:
-	@echo "===> Generating $@"
-	@cd $(DOCS) && DEST=$(CURDIR) VERSIONMASK=1 make $(CURDIR)/nginx-module-$*.deb-changelog
-	@sed -i -e 's,nginx-module-,nginx$(MODULE_SUFFIX)-module-,g' $(CURDIR)/$@
+	@echo "===> Using static $@ (xslscript docs generation skipped)"
 
 rules-module-%: $(BASE_SRC) nginx-module-%.deb-changelog .deps-module-%
 	@echo "===> Creating $@"
--- a/debian/Makefile.module-njs
+++ b/debian/Makefile.module-njs
@@ -3,21 +3,15 @@
 MODULE_SUMMARY_njs=	njs dynamic modules
 
 include $(CONTRIB)/src/njs/version
-include $(CONTRIB)/src/quickjs/version
 
 MODULE_VERSION_njs=	$(NJS_VERSION)
-MODULE_RELEASE_njs=	1
+MODULE_RELEASE_njs=	3
 
-MODULE_SOURCES_njs=	\
-					njs-$(NJS_VERSION).tar.gz \
-					quickjs-$(QUICKJS_VERSION).tar.xz
+MODULE_SOURCES_njs=	njs-$(NJS_VERSION).tar.gz
 
 MODULE_CONFARGS_njs=	--add-dynamic-module=$(MODSRC_PREFIX)njs-$(NJS_VERSION)/nginx
 
 .deps-module-njs:
-	cd $(CONTRIB) && make \
-						.sum-njs \
-						.sum-quickjs
 	touch $@
 
 MODULE_VERSION_PREFIX_njs=$(MODULE_TARGET_PREFIX)
@@ -25,12 +19,8 @@
 MODULE_BUILD_DEPENDS_njs=,libedit-dev,libxml2-dev,libxslt-dev
 
 define MODULE_PREBUILD_njs
-	cd $$(CURDIR)/debian/extra/quickjs-$(QUICKJS_VERSION) \&\& \
-	$(MAKE) -j$$(NUMJOBS) install PREFIX=$$(BUILDDIR_nginx)/extra/prebuilt/ \&\& \
 	cd $$(CURDIR)/debian/extra/njs-$(NJS_VERSION) \&\& \
-	./configure \
-		--cc-opt="$$(CFLAGS) -I$$(BUILDDIR_nginx)/extra/prebuilt/include/quickjs/" \
-		--ld-opt="$$(LDFLAGS) -L$$(BUILDDIR_nginx)/extra/prebuilt/lib/quickjs/" \&\& \
+	./configure --cc-opt="$$(CFLAGS)" --ld-opt="$$(LDFLAGS)" \&\& \
 	make -j$$(NUMJOBS) njs \&\& \
 	mv build build-cli
 endef
